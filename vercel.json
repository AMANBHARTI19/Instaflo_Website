{
  "version": 2,
  "builds": [
    { "src": "api/not-found.js", "use": "@vercel/node" },
    { "src": "api/waitlist.js", "use": "@vercel/node" },
    { "src": "api/geo.js", "use": "@vercel/node" },
    { "src": "DMflo Website/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/waitlist", "dest": "/api/waitlist.js" },
    { "src": "/api/geo", "dest": "/api/geo.js" },
    { "src": "/assets/(.*)", "dest": "/DMflo Website/assets/$1" },
    { "src": "/demo-app/(.*)", "dest": "/DMflo Website/demo-app/$1" },
    { "src": "/(.*\\.(css|js|svg|png|jpg|ico|jsx|txt|xml))", "dest": "/DMflo Website/$1" },
    { "src": "/([a-z0-9-]*)\\.html", "dest": "/DMflo Website/$1.html" },
    { "src": "/about", "dest": "/DMflo Website/about.html" },
    { "src": "/contact", "dest": "/DMflo Website/contact.html" },
    { "src": "/privacy", "dest": "/DMflo Website/privacy.html" },
    { "src": "/support", "dest": "/DMflo Website/support.html" },
    { "src": "/terms", "dest": "/DMflo Website/terms.html" },
    { "src": "/features", "dest": "/DMflo Website/features.html" },
    { "src": "/pricing", "dest": "/DMflo Website/pricing.html" },
    { "src": "/mcp", "dest": "/DMflo Website/mcp.html" },
    { "src": "/sitemap", "dest": "/DMflo Website/sitemap.xml" },
    { "src": "/llms", "dest": "/DMflo Website/llms.txt" },
    { "src": "/", "dest": "/DMflo Website/index.html" },
    { "src": "/(.*)", "dest": "/api/not-found" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Vary", "value": "Accept, Accept-Encoding" }
      ]
    }
  ]
}
